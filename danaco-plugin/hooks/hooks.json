{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/po_zapisie.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/po_zapisie.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
