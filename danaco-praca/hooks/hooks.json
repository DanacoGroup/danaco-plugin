{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" narzedzie",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" sesja",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hak.sh\" sesja",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
