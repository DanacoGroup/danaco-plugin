{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Edit(./**)",
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm test *)",
      "Bash(git diff *)",
      "Bash(git status)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Agent",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "disableAutoMode": "disable",
  "disableAllHooks": true,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
