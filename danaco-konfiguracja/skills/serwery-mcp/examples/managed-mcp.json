{
  "mcpServers": {
    "dokumentacja": {
      "type": "http",
      "url": "https://mcp.wewnetrzne.example.com/dokumentacja"
    },
    "repozytoria": {
      "type": "http",
      "url": "https://mcp.wewnetrzne.example.com/git",
