{
  "description": "Formatowanie plików Pythona po edycji",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/po_edycji.py", "${user_config.formater}"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
